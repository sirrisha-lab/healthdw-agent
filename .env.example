# Which LLM to use: "ollama" (free, runs on your laptop) or "openai" (paid API)
LLM_PROVIDER=ollama

# --- Ollama (free, local) ---
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434

# --- OpenAI (optional, only if LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=<your-key>
# OPENAI_MODEL=gpt-4o-mini

# SQL Server — use the dedicated read-only login created by sql/create_readonly_login.sql
# Do NOT use your own Windows-authenticated admin login here.
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=HealthDW
SQL_LOGIN=ai_agent_reader
SQL_PASSWORD=<the password you set in the SQL script>

# Safety limits
MAX_ROWS=200
QUERY_TIMEOUT_SECONDS=10
